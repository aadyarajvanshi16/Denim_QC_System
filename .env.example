# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development enables Flask debug mode + relaxes cookie security; use "production" everywhere else
FLASK_ENV=production
FLASK_DEBUG=false

# sqlite:///instance/denim_qc.db for local, or a real postgres URL in prod
DATABASE_URL=sqlite:///instance/denim_qc.db

UPLOAD_FOLDER=uploads
RESULT_FOLDER=static/results
SAVED_REPORTS_FOLDER=saved_reports
MAX_UPLOAD_MB=15

CAMERA_SOURCE=webcam
RTSP_URL=
RECONNECT_DELAY=5

DELTA_E_PASS_THRESHOLD=2.0
DELTA_E_ACCEPTABLE_THRESHOLD=5.0

# set true once you're behind HTTPS
SESSION_COOKIE_SECURE=false

# used once by `flask create-admin` to seed the first account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
