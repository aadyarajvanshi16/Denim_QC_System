# Local development environment file.
# This file is git-ignored on purpose — never commit real secrets.
# On another machine (or in production), copy .env.example to .env and fill it in fresh.

SECRET_KEY=42d49bd059935e0a26f39039b2bbe56be74e99ed7633cd8c6507294acd7500b

FLASK_ENV=development
FLASK_DEBUG=true

# DATABASE_URL=sqlite:///instance/denim_qc.db

UPLOAD_FOLDER=uploads
RESULT_FOLDER=static/results
SAVED_REPORTS_FOLDER=saved_reports
